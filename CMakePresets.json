{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2026-x64",
      "displayName": "Visual Studio 2026 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vscode",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/.deps/Qt/6.10.1/msvc2022_64"
      }
    },
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vscode-2022",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/.deps/Qt/6.10.1/msvc2022_64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "PATH": "${sourceDir}/.deps/Qt/6.10.1/msvc2022_64/bin;$penv{PATH}"
      }
    },
    {
      "name": "release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "PATH": "${sourceDir}/.deps/Qt/6.10.1/msvc2022_64/bin;$penv{PATH}"
      }
    }
  ]
}
