{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Release",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build-release.ps1",
        "-QtDir",
        "${workspaceFolder}/.deps/Qt/6.10.1/msvc2022_64"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Package Release",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/package-release.ps1",
        "-QtDir",
        "${workspaceFolder}/.deps/Qt/6.10.1/msvc2022_64"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/d",
        "/s",
        "/c",
        "set \"PATH=${workspaceFolder}\\.deps\\Qt\\6.10.1\\msvc2022_64\\bin;%PATH%\" && \"C:\\Program Files (x86)\\Microsoft Visual Studio\\18\\BuildTools\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\CMake\\bin\\ctest.exe\" --test-dir \"${workspaceFolder}\\build\" -C Release --output-on-failure"
      ],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
