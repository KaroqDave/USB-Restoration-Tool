    <qresource prefix="/icons">
        <file alias="app.ico">icons/app.ico</file>
        <file alias="app.png">icons/app.png</file>
        <file alias="chevron-down-light.svg">icons/chevron-down-light.svg</file>
        <file alias="chevron-down-dark.svg">icons/chevron-down-dark.svg</file>
    </qresource>
</RCC>
